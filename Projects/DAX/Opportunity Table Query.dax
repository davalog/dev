
// DAX Expression to pull and rename Opportunity table (excluding broken columns)
EVALUATE
    SELECTCOLUMNS(
        'Opportunity',
        "accountid", Opportunity[accountid],
        "AlreadyWon", Opportunity[Already Won],
        "LifecycleRampYears", Opportunity[Lifecycle/Ramp Years],
        "OpportunityName", Opportunity[Opportunity Name],
        "OpportunityNumber", Opportunity[Opportunity Number],
        "RefPlatformDesignSystemFlag", Opportunity[Ref/Platform Design System Flag],
        "adi_saleslink", Opportunity[adi_saleslink],
        "StageName", Opportunity[Stage Name],
        "StartofMassProductionDate", Opportunity[Start of Mass Production Date],
        "CreatedOn", Opportunity[Created On],
        "CustomerOpportunityName", Opportunity[Customer - Opportunity Name],
        "opportunityid", Opportunity[opportunityid],
        "parentaccountid", Opportunity[parentaccountid],
        "statecodevalue", Opportunity[statecodevalue],
        "StateCode", Opportunity[State Code],
        "statuscodevalue", Opportunity[statuscodevalue],
        "StatusCode", Opportunity[Status Code],
        "EstDesignInDate", Opportunity[Est. Design In Date],
        "adi_endmarketgnosticid", Opportunity[adi_endmarketgnosticid],
        "ActiveProductCount", Opportunity[Active Product Count],
        "adi_bulink", Opportunity[adi_bulink],
        "ExpectedLifetimeValue", Opportunity[Expected Lifetime Value],
        "ExpectedPeakAnnualValue", Opportunity[Expected Peak Annual Value],
        "LifetimeQuantity", Opportunity[Lifetime Quantity],
        "LifetimeValue", Opportunity[Lifetime Value],
        "PeakAnnlSysBoardQty", Opportunity[Peak Ann'l Sys/Board Qty],
        "PeakAnnualValue", Opportunity[Peak Annual Value],
        "ScheduleLifeYears", Opportunity[Schedule Life Years],
        "SubscriptionsServiceValue", Opportunity[Subscriptions/Service Value],
        "LegacyApplicationText", Opportunity[Legacy Application Text],
        "IsOverdue", Opportunity[Is overdue?],
        "EndMarketSegment", Opportunity[End Market Segment],
        "EndMarketSubsegment", Opportunity[End Market Subsegment],
        "EndMarketGroup", Opportunity[End Market Group],
        "EndMarketSubgroup", Opportunity[End Market Subgroup],
        "EndMarketGnostic", Opportunity[End Market Gnostic],
        "OpportunityNumberName", Opportunity[Opportunity (Number - Name)],
        "RefPlatformDesign", Opportunity[Ref/Platform Design],
        "TechnicalTeamMemberMerged", Opportunity[Technical Team Member (Merged)],
        "PendingBillingsInProgressStatus", Opportunity[Pending Billings/In Progress Status],
        "PendingBillingValidation", Opportunity[Pending Billing Validation],
        "adi_opportunitytype_display", Opportunity[adi_opportunitytype_display],
        "OpenSOPin2weeks?", Opportunity[Open SOP in 2 weeks?],
        "SOP_FY", Opportunity[SOP_FY],
        "description", Opportunity[description],
        "ModifiedOn", Opportunity[Modified On],
        "IsYTDQTDMTDDIN", Opportunity[Is YTD/QTD/MTD D-IN],
        "IsYTDQTDMTDDWIN", Opportunity[Is YTD/QTD/MTD DWIN],
        "IsCurrentFY_Open", Opportunity[Is Current FY_Open],
        "ExcludeFromPipeline", Opportunity[Exclude from pipeline],
        "OEMCustomer", Opportunity[OEM Customer],
        "OEMCustomerName", Opportunity[OEM Customer Name],
        "End_Mkt_Hierarchy_key", Opportunity[End_Mkt_Hierarchy_key],
        "Include_Ecosystem_No", Opportunity[Include_Ecosystem_No],
        "Include_Ecosystem_Yes", Opportunity[Include_Ecosystem_Yes],
        "LostCommentary", Opportunity[Lost Commentary],
        "SOP_FYGroup", Opportunity[SOP_FY Group],
        "AnchorPartsMerged", Opportunity[Anchor Parts (Merged)],
        "adi_fse", Opportunity[adi_fse],
        "adi_bluesky", Opportunity[adi_bluesky],
        "adi_blueskylevel_display", Opportunity[adi_blueskylevel_display],
        "AllPartsAreDINLineStatus", Opportunity[All Parts are D-IN line Status?],
        "PowerOpps_IncludeLostpart", Opportunity[Power Opps_Include Lost part],
        "TechnicalTeamMemberEmailMerged", Opportunity[Technical Team Member Email (Merged)]
    )